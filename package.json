{
  "name": "repack-microfrontends",
  "private": true,
  "description": "Minimum micro-frontends React Native example using Re.Pack and Module Federation.",
  "scripts": {
    "host:start": "npm start --prefix apps/host",
    "mini:start": "npm start --prefix apps/mini",
    "host:android": "npm run android --prefix apps/host",
    "host:ios": "npm run ios --prefix apps/host",
    "mini:android": "npm run android --prefix apps/mini",
    "mini:ios": "npm run ios --prefix apps/mini",
    "host:test": "npm test --prefix apps/host",
    "mini:test": "npm test --prefix apps/mini",
    "test": "npm run host:test && npm run mini:test",
    "host:bundle": "npm run bundle:android --prefix apps/host",
    "mini:bundle": "npm run bundle:android --prefix apps/mini",
    "crypto:start": "npm start --prefix apps/crypto",
    "crypto:android": "npm run android --prefix apps/crypto",
    "crypto:ios": "npm run ios --prefix apps/crypto",
    "crypto:test": "npm test --prefix apps/crypto"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
